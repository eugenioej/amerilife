{
  "name": "amerilife",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm install --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "scrape:agencies": "pnpm --dir frontend run scrape:agencies",
    "enrich:agencies": "pnpm --dir frontend run enrich:agencies",
    "enrich:agencies-llm": "pnpm --dir frontend run enrich:agencies-llm",
    "pipeline:agencies": "pnpm --dir frontend run pipeline:agencies",
    "import:all-agencies": "pnpm --dir frontend run import:all-agencies",
    "export:scraped-csv": "pnpm --dir frontend run export:scraped-csv",
    "apply:agency-defaults": "pnpm --dir frontend run apply:agency-defaults"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
