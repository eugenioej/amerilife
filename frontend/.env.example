# Production environment variables for WP Engine/Atlas
# Copy to your hosting provider's secret/env manager. Do NOT commit real values.

# GraphQL endpoint (headless WordPress)
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://headlessameril.wpenginepowered.com/graphql

# Use headless WP for images. Set to 0 for production (serves from headless).
NEXT_PUBLIC_USE_LIVE_IMAGES=0

# Enable image sync during build (required for images to appear in production)
SYNC_WP_IMAGES=1

# SFTP credentials for headless WP uploads (set in WP Engine secrets, never commit)
HEADLESS_SFTP_HOST=headlessameril.sftp.wpengine.com
HEADLESS_SFTP_PORT=2222
HEADLESS_SFTP_USER=
HEADLESS_SFTP_PASSWORD=

# Optional: skip Media Library registration (recommended for "images render" only)
# SYNC_WP_IMPORT_MEDIA_LIBRARY=0

# Optional: additional source hosts if content references UAT URLs
# SYNC_WP_SOURCE_HOSTS=amerilife.com,www.amerilife.com,uatamerilife.wpengine.com
