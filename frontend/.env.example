# Production environment variables for WP Engine/Atlas
# Set these in Atlas: Settings → Environment Variables / Secrets
# See docs/DEPLOYMENT.md for step-by-step Atlas configuration.

# === Required for production (images served from headless WP) ===
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://headlessameril.wpenginepowered.com/graphql
NEXT_PUBLIC_USE_LIVE_IMAGES=0

# Same reCAPTCHA Site Key as WordPress → Gravity Forms → Settings → reCAPTCHA (required for headless form submit)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY= 

# === Optional: seed demo Insights in WordPress (pnpm seed:insights:wp) ===
# Prefer WORDPRESS_PASSWORD (normal wp-admin login password) — script uses wp-login.php session cookies.
# Or WORDPRESS_APP_PASSWORD, or reuse HEADLESS_WP_APP_USER / HEADLESS_WP_APP_PASSWORD (same as sync:wp-images).
# If WORDPRESS_USER / WORDPRESS_APP_PASSWORD are set in frontend/.env.local, they override HEADLESS_*.
# WORDPRESS_URL=https://headlessameril.wpenginepowered.com
# WORDPRESS_USER=your_wp_login
# WORDPRESS_PASSWORD=your_wp_admin_password
# WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# HEADLESS_WP_APP_USER=mediauploader
# HEADLESS_WP_APP_PASSWORD=
# FORCE=1   # optional: delete existing insights and re-import

# === Frontend site URL (canonical / OAuth) ===
# Production: https://amerilife.com
NEXT_PUBLIC_SITE_URL=https://amerilife.com
# Auth.js canonical URL — must match the public domain (same as Entra redirect URI origin)
# AUTH_URL=https://amerilife.com

# === ideaXchange — Microsoft Entra JIT auth (Sign in with Microsoft) ===
# Generate AUTH_SECRET: pnpm exec auth secret   (or: openssl rand -base64 32)
# AUTH_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=          # App registration → Application (client) ID
# AUTH_MICROSOFT_ENTRA_ID_SECRET=      # Client secret value
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=   # Directory (tenant) ID — restricts sign-in to your org
#
# Entra → App registration → Authentication → Redirect URI (Web):
#   https://amerilife.com/api/auth/callback/microsoft-entra-id
# Local dev:
#   http://localhost:3000/api/auth/callback/microsoft-entra-id
#
# IdeaXchange login: https://amerilife.com/ideaxchange/
# Optional: map Entra security group object IDs (GUIDs) to personas when not using App Roles
# IDEAXCHANGE_ENTRA_GROUP_SALES_ID=
# IDEAXCHANGE_ENTRA_GROUP_RECRUIT_ID=
# IDEAXCHANGE_ENTRA_GROUP_CARRIER_ID=
# IDEAXCHANGE_ENTRA_GROUP_LEADERSHIP_ID=
#
# App Roles (recommended): create in Entra app registration → App roles
# IDEAXCHANGE_SALES | IDEAXCHANGE_RECRUIT | IDEAXCHANGE_CARRIER | IDEAXCHANGE_LEADERSHIP | IDEAXCHANGE_ADMIN
#
# Legacy shared-password gate (used only when Entra vars above are NOT set — local dev)
# IDEAXCHANGE_GATE_PASSWORD=

# === Optional: sync images to headless WP (in-house hosting) ===
# 1. Download only (no credentials): pnpm sync:wp-images:download
# 2. Full sync (upload to headless): set vars below, then pnpm sync:wp-images
# SYNC_WP_IMAGES=1
# SYNC_WP_DOWNLOAD_ONLY=1
# HEADLESS_SFTP_HOST=headlessameril.sftp.wpengine.com
# HEADLESS_SFTP_PORT=2222
# HEADLESS_SFTP_USER=
# HEADLESS_SFTP_PASSWORD=
# SYNC_WP_IMPORT_MEDIA_LIBRARY=1
# HEADLESS_WP_APP_USER=mediauploader
# HEADLESS_WP_APP_PASSWORD=
# SYNC_WP_SOURCE_HOSTS=amerilife.com,www.amerilife.com

# === Optional: blog post migration from old Divi site ===
# WP_SOURCE_URL=https://amerilife.com
# MIGRATE_DELAY_MS=500
