# Production environment variables for WP Engine/Atlas
# Set these in Atlas: Settings → Environment Variables / Secrets
# See docs/DEPLOYMENT.md for step-by-step Atlas configuration.

# === Required for production (images served from headless WP) ===
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://headlessameril.wpenginepowered.com/graphql
NEXT_PUBLIC_USE_LIVE_IMAGES=0

# === Optional: frontend site URL for canonical/OG (rewrites Yoast URLs from WP to frontend) ===
# NEXT_PUBLIC_SITE_URL=https://www.amerilife.com

# === Optional: sync images to headless WP (in-house hosting) ===
# 1. Download only (no credentials): pnpm sync:wp-images:download
# 2. Full sync (upload to headless): set vars below, then pnpm sync:wp-images
# SYNC_WP_IMAGES=1
# SYNC_WP_DOWNLOAD_ONLY=1
# HEADLESS_SFTP_HOST=headlessameril.sftp.wpengine.com
# HEADLESS_SFTP_PORT=2222
# HEADLESS_SFTP_USER=
# HEADLESS_SFTP_PASSWORD=
# SYNC_WP_IMPORT_MEDIA_LIBRARY=1
# HEADLESS_WP_APP_USER=mediauploader
# HEADLESS_WP_APP_PASSWORD=
# SYNC_WP_SOURCE_HOSTS=amerilife.com,www.amerilife.com,uatamerilife.wpengine.com

# === Optional: blog post migration from old Divi site ===
# WP_SOURCE_URL=https://amerilife.com
# MIGRATE_DELAY_MS=500
